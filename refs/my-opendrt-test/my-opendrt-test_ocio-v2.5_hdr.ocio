ocio_profile_version: 2.5

environment:
  {}
search_path:
  - luts
  - transfer_functions
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: my-opendrt-test
description: An OCIO config generated with ociogen.

roles:
  aces_interchange: ACES 2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_picking: Filmlight - E-Gamut2 - Linear
  color_timing: Filmlight - E-Gamut2 - T-Log
  compositing_linear: Filmlight - E-Gamut2 - Linear
  compositing_log: Filmlight - E-Gamut2 - T-Log
  data: Filmlight - E-Gamut2 - Linear
  default: Filmlight - E-Gamut2 - Linear
  mari_monitor: Filmlight - E-Gamut2 - Linear
  matte_paint: Filmlight - E-Gamut2 - T-Log
  reference: Filmlight - E-Gamut2 - Linear
  scene_linear: Filmlight - E-Gamut2 - Linear
  texture_paint: Filmlight - E-Gamut2 - Linear

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  Display P3:
    - !<View> {name: OpenDRT-aery, view_transform: OpenDRT-aery - Display P3, display_colorspace: Display P3}
    - !<View> {name: OpenDRT-arriba, view_transform: OpenDRT-arriba - Display P3, display_colorspace: Display P3}
    - !<View> {name: OpenDRT-colorful, view_transform: OpenDRT-colorful - Display P3, display_colorspace: Display P3}
    - !<View> {name: OpenDRT-dystopic, view_transform: OpenDRT-dystopic - Display P3, display_colorspace: Display P3}
    - !<View> {name: OpenDRT-standard, view_transform: OpenDRT-standard - Display P3, display_colorspace: Display P3}
    - !<View> {name: OpenDRT-sylvan, view_transform: OpenDRT-sylvan - Display P3, display_colorspace: Display P3}
    - !<View> {name: OpenDRT-umbra, view_transform: OpenDRT-umbra - Display P3, display_colorspace: Display P3}
    - !<View> {name: Display Encoding, view_transform: Un-tone-mapped, display_colorspace: Display P3}
    - !<View> {name: Bypass, colorspace: bypass}
  Rec2100 PQ:
    - !<View> {name: OpenDRT-aery, view_transform: OpenDRT-aery - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: OpenDRT-arriba, view_transform: OpenDRT-arriba - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: OpenDRT-colorful, view_transform: OpenDRT-colorful - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: OpenDRT-dystopic, view_transform: OpenDRT-dystopic - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: OpenDRT-standard, view_transform: OpenDRT-standard - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: OpenDRT-sylvan, view_transform: OpenDRT-sylvan - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: OpenDRT-umbra, view_transform: OpenDRT-umbra - Rec2100 PQ, display_colorspace: Rec2100 PQ}
    - !<View> {name: Display Encoding, view_transform: Un-tone-mapped, display_colorspace: Rec2100 PQ}
    - !<View> {name: Bypass, colorspace: bypass}
  sRGB Display:
    - !<View> {name: OpenDRT-aery, view_transform: OpenDRT-aery - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: OpenDRT-arriba, view_transform: OpenDRT-arriba - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: OpenDRT-colorful, view_transform: OpenDRT-colorful - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: OpenDRT-dystopic, view_transform: OpenDRT-dystopic - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: OpenDRT-standard, view_transform: OpenDRT-standard - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: OpenDRT-sylvan, view_transform: OpenDRT-sylvan - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: OpenDRT-umbra, view_transform: OpenDRT-umbra - sRGB Display, display_colorspace: sRGB Display}
    - !<View> {name: Display Encoding, view_transform: Un-tone-mapped, display_colorspace: sRGB Display}
    - !<View> {name: Bypass, colorspace: bypass}

active_displays: [Display P3, Rec2100 PQ, sRGB Display]
active_views: [OpenDRT-aery, OpenDRT-arriba, OpenDRT-colorful, OpenDRT-dystopic, OpenDRT-standard, OpenDRT-sylvan, OpenDRT-umbra, Display Encoding, Bypass]

default_view_transform: Un-tone-mapped

view_transforms:
  - !<ViewTransform>
    name: Un-tone-mapped
    family: Utility
    description: No tone mapping. Scene-linear 1.0 = display 1.0 (100 nits).
    from_scene_reference: !<MatrixTransform> {matrix: [0.736477654735668, 0.130739675260529, 0.0832385672853298, 0, 0.275069962311446, 0.828017832828021, -0.103087777919318, 0, -0.124225154900064, -0.0871597688344374, 1.30044263709048, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-aery - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-aery.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-arriba - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-arriba.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-colorful - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-colorful.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-dystopic - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-dystopic.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-standard - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-standard.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-sylvan - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-sylvan.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-umbra - Display P3
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_display-p3_OpenDRT-umbra.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          children:
            - !<ExponentTransform> {value: 2.2}
            - !<MatrixTransform> {matrix: [0.486570948648216, 0.265667693169093, 0.198217285234362, 0, 0.228974564069749, 0.691738521836506, 0.079286914093745, 0, -3.97207551693349e-17, 0.0451133818589026, 1.04394436890098, 0, 0, 0, 0, 1]}

  - !<ViewTransform>
    name: OpenDRT-aery - Rec2100 PQ
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_rec2100-pq_OpenDRT-aery.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
          direction: inverse
          children:
