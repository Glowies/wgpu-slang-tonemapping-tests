  - !<ColorSpace>
    name: ACES 2065-1
    aliases: [ap0]
    family: Working Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: scene-linear
    allocation: uniform
    to_scene_reference: !<MatrixTransform> {matrix: [1.25992122474977, -0.180662379244654, -0.0792588455051215, 0, 0.00486107030443775, 0.944082892223335, 0.0510560374722275, 0, 0.121236193720255, 0.0466469429928843, 0.83211686328686, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACEScg
    aliases: [ap1]
    family: Working Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: scene-linear
    allocation: uniform
    to_scene_reference: !<MatrixTransform> {matrix: [0.868560322361992, 0.0216148124030379, 0.10982486523497, 0, 0.0453882935158179, 0.812490156195302, 0.14212155028888, 0, 0.0818053320392553, 0.0605058247267323, 0.857688843234013, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: ACEScct
    family: Working Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: log
    allocation: uniform
