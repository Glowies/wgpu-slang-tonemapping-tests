display_colorspaces:
  - !<ColorSpace>
    name: CIE-XYZ-D65
    aliases: [lin_ciexyzd65_scene]
    interop_id: lin_ciexyzd65_scene
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    description: CIE XYZ D65 display-linear. 1.0 = 100 nits.
    isdata: false
    encoding: display-linear
    allocation: uniform

  - !<ColorSpace>
    name: Rec.1886
    aliases: [rec1886, g24_rec709_display]
    interop_id: g24_rec709_display
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_REC.1886-REC.709}

  - !<ColorSpace>
    name: sRGB Display
    aliases: [srgb-display, g22_rec709_display]
    interop_id: g22_rec709_display
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_G2.2-REC.709}

  - !<ColorSpace>
    name: sRGB Encoding
    aliases: [srgb-encoding, srgb_rec709_display]
    interop_id: srgb_rec709_display
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_sRGB}

  - !<ColorSpace>
    name: DCIP3 D65
    aliases: [dci-p3d65, g26_p3d65_display]
    interop_id: g26_p3d65_display
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_G2.6-P3-D65}

  - !<ColorSpace>
    name: Display P3
    aliases: [display-p3, srgb_p3d65_display]
    interop_id: srgb_p3d65_display
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: sdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_DisplayP3}

  - !<ColorSpace>
    name: Rec2100 PQ
    aliases: [pq, pq_rec2020_display]
    interop_id: pq_rec2020_display
    family: Display Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: hdr-video
    allocation: uniform
    from_display_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_REC.2100-PQ}

colorspaces:
  - !<ColorSpace>
    name: bypass
    aliases: [raw]
    family: Working Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: true
    encoding: data
    allocation: uniform

  - !<ColorSpace>
    name: XYZ D65
    aliases: [xyzd65]
    family: Working Spaces
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: scene-linear
    allocation: uniform
    to_scene_reference: !<MatrixTransform> {matrix: [1.35702367254585, -0.237033581941448, -0.119990090604401, 0, -0.438325988676953, 1.29442894440374, 0.143897044273212, 0, 0.100252080766426, 0.0641140083985013, 0.835633910835072, 0, 0, 0, 0, 1]}

