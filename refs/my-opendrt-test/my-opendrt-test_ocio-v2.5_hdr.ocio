  - !<ViewTransform>
    name: OpenDRT-arriba - Rec2100 PQ
    family: OpenDRT
    from_scene_reference: !<GroupTransform>
      children:
        - !<ColorSpaceTransform> {src: Filmlight - E-Gamut2 - Linear, dst: ACEScct}
        - !<FileTransform> {src: acescct_to_rec2100-pq_OpenDRT-arriba.spi3d, interpolation: tetrahedral}
        - !<GroupTransform>
